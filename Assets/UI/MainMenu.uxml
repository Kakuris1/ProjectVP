<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=ac883a1ef7aa49a46a1a4fe275f3d5cf&amp;type=3#MainMenu" />
    <ui:VisualElement name="Root" class="root" style="height: 1080px; width: 1920px; flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/MainMenuBackgroundImage.jpg?fileID=2800000&amp;guid=4518083f4db55c54697d2ddd13f9b424&amp;type=3#MainMenuBackgroundImage&quot;);">
        <ui:VisualElement name="MainPanel" class="panel" style="height: 1077px; width: 1917px; position: relative; top: -1px; left: 0; flex-grow: 1; align-items: center; justify-content: center;">
            <ui:Label text="CIRCARIUM" name="GameTitle" style="font-size: 70px; color: rgb(255, 255, 255); -unity-font-style: normal; position: relative; top: auto; left: auto; -unity-text-align: middle-center;" />
            <ui:Button name="StartButton" text="Start" />
            <ui:Button name="OptionButton" text="Option" />
            <ui:Button name="QuitButton" text="Quit" />
        </ui:VisualElement>
        <ui:VisualElement name="OptionPanel" enabled="true" class="panel hidden" style="height: 1078px; position: absolute; width: 1920px; align-items: center; justify-content: center;">
            <ui:DropdownField label="Screen" name="ScreenDropbox" enabled="true" style="position: relative; top: auto; left: auto; width: 938px; height: 51px; background-color: rgba(255, 255, 255, 0); font-size: 40px; color: rgb(255, 255, 255);" />
            <ui:Slider label="BGM" value="42" high-value="100" fill="true" name="BGMController" style="position: relative; top: auto; left: auto; height: 111px; width: 912px; font-size: 40px; color: rgb(255, 255, 255);" />
            <ui:Slider label="Effect" value="42" high-value="100" fill="true" name="EffectController" style="position: relative; top: auto; left: auto; height: 111px; width: 912px; font-size: 40px; color: rgb(255, 255, 255);" />
            <ui:Button name="BackButton" text="Back" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
